# Copy to .env (never commit the real file)
DB_HOST=127.0.0.1
DB_NAME=nutriplan
DB_USER=root
DB_PASS=

# Server-side only. This key must never be shipped inside the Flutter app.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Restrict this to your web origin in production
CORS_ORIGIN=*

# Development only: show Claude API error details in the app
APP_DEBUG=0

# Optional: send Claude requests somewhere other than api.anthropic.com (an API gateway, or a test stand-in)
# ANTHROPIC_API_URL=
