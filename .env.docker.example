# Copy to .env next to docker-compose.yml. Never commit, zip or screenshot the real file.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Database passwords (required). Use long random values; see README or the setup commands.
# They only take effect when the database volume is first created.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Email for password reset and sign-in codes (any normal mailbox that allows SMTP).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=tls, SMTP_USER=you@gmail.com,
#        SMTP_PASS=a 16-letter app password (Google account > Security > App passwords).
# Testing without a mailbox: leave SMTP_HOST empty and set MAIL_LOG_ONLY=1; emails (with their
# codes) then only appear in `docker compose logs api`. Never use MAIL_LOG_ONLY on a real server.
MAIL_LOG_ONLY=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NutriPlan <you@example.com>

# Optional
# API_BIND=127.0.0.1   # only reachable from this computer (USB / emulator testing)
# APP_DEBUG=1          # show Claude's own error text in the app while debugging
# CORS_ORIGIN=         # only for a Flutter web build, e.g. https://app.example.com
# DAILY_PLAN_LIMIT=100 # plans the whole server may start per 24 h
# DAILY_SCAN_LIMIT=300 # photo scans the whole server may run per 24 h
